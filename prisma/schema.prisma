/**
 * Generator block — defines how and where the Prisma client is generated.
 * @property provider        - Specifies the generator type. "prisma-client-js"
 * generates the Prisma Client used to interact
 * with the database.
 * @property output          - Custom output directory for the generated client.
 * Defaults to `node_modules/@prisma/client` if omitted.
 * Here it is set to `../generated/prisma` relative to
 * the schema file location.
 * @property previewFeatures - Opts in to experimental Prisma features not yet
 * stable. "fullTextSearchPostgres" enables native
 * full-text search support for PostgreSQL, allowing
 * use of the `search` filter on string fields.
 */
generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["fullTextSearchPostgres"]
}

/**
 * Datasource block — configures the database connection.
 * @property provider - The type of database to connect to. Set to "postgresql"
 * for a PostgreSQL database.
 * @note The connection URL is intentionally omitted here and is instead
 * supplied at runtime via the `prisma.config.ts` file using the
 * `DATABASE_URL` environment variable. This avoids hardcoding
 * sensitive credentials in the schema file.
 */
datasource db {
  provider = "postgresql"
}

/**
 * User model — represents an application user in the database.
 * Typically synchronised with an external authentication provider
 * (e.g., Clerk) via the `externalUserId` field, which stores the
 * provider-issued identifier used to map external sessions to local
 * user records.
 * @property id             - Unique internal identifier (UUID), auto-generated.
 * @property username       - The user's unique display name.
 * @property imageUrl       - URL pointing to the user's profile image
 * (stored as TEXT).
 * @property externalUserId - Unique identifier issued by the external auth
 * provider (stored as TEXT). Used to associate
 * auth sessions with local user records.
 * @property bio            - Optional short biography or description
 * (stored as TEXT).
 * @property following      - Users that this user follows (via the Follow
 * relation, "Following" side). Populated through
 * the Follow join model.
 * @property followedBy     - Users that follow this user (via the Follow
 * relation, "FollowedBy" side). Populated through
 * the Follow join model.
 * @property blocking       - Users that this user has blocked (via the Block
 * relation, "Blocking" side). Populated through
 * the Block join model.
 * @property blockedBy      - Users that have blocked this user (via the Block
 * relation, "BlockedBy" side). Populated through
 * the Block join model.
 * @property stream         - The live stream associated with this user, if any.
 * Each user may own at most one Stream record
 * (optional one-to-one relation).
 * @property createdAt      - Timestamp of when the user record was created
 * (auto-set).
 * @property updatedAt      - Timestamp of the last update to the user record
 * (auto-updated).
 */
model User {
  id             String   @id @default(uuid())
  username       String   @unique
  imageUrl       String   @db.Text
  externalUserId String   @unique @db.Text
  bio            String?  @db.Text
  following      Follow[] @relation("Following")
  followedBy     Follow[] @relation("FollowedBy")
  blocking       Block[]  @relation("Blocking")
  blockedBy      Block[]  @relation("BlockedBy")
  stream         Stream?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/**
 * Follow model — represents a directed follow relationship between two users.
 * Acts as an explicit many-to-many join table between User records.
 * A single Follow record encodes that `follower` (identified by `followerId`)
 * has chosen to follow `following` (identified by `followingId`).
 * Relation naming convention used with the User model:
 * - "Following"  — the follower's perspective (the user doing the following).
 * - "FollowedBy" — the followee's perspective (the user being followed).
 * Cascade deletion ensures that follow records are automatically removed
 * when either the follower or the followed user is deleted, preventing
 * orphaned rows in the database.
 * @property id          - Unique identifier for the follow relationship (UUID),
 * auto-generated.
 * @property followerId  - Foreign key referencing the User who is following.
 * @property followingId - Foreign key referencing the User being followed.
 * @property follower    - Relation field resolving to the follower User record.
 * Linked via the "Following" relation on User.
 * Cascades deletion when the follower user is removed.
 * @property following   - Relation field resolving to the followed User record.
 * Linked via the "FollowedBy" relation on User.
 * Cascades deletion when the followed user is removed.
 * @property createdAt   - Timestamp of when the follow relationship was created
 * (auto-set).
 * @property updatedAt   - Timestamp of the last update to this record
 * (auto-updated).
 * @unique [followerId, followingId] - Prevents duplicate follow relationships;
 * a user can only follow another user once.
 * @index  followerId                - Optimises queries that look up all users
 * a given user is following.
 * @index  followingId               - Optimises queries that look up all
 * followers of a given user.
 */
model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  follower    User     @relation(name: "Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation(name: "FollowedBy", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

/**
 * Stream model — represents a live stream owned by a single User.
 * Each stream is uniquely associated with one user (one-to-one relation).
 * Cascade deletion ensures the stream record is automatically removed when
 * its owning user is deleted, preventing orphaned rows in the database.
 * @property id                  - Unique internal identifier (UUID),
 * auto-generated.
 * @property name                - Display name / title of the stream
 * (stored as TEXT). Indexed to support
 * full-text search via `previewFeatures`.
 * @property thumbnailUrl        - Optional URL pointing to the stream's
 * thumbnail image (stored as TEXT).
 * @property ingressId           - Optional unique identifier assigned by the
 * ingress/ingest service (e.g., LiveKit).
 * Used to correlate incoming media streams
 * with their database records.
 * @property serverUrl           - Optional URL of the media server that the
 * streamer should publish to (stored as TEXT).
 * @property streamKey           - Optional secret key used to authenticate
 * the streamer's publishing session
 * (stored as TEXT).
 * @property isLive              - Indicates whether the stream is currently
 * live. Defaults to `false`.
 * @property isChatEnabled       - Controls whether the chat feature is active
 * for this stream. Defaults to `true`.
 * @property isChatDelayed       - Controls whether chat messages are displayed
 * with a delay. Defaults to `false`.
 * @property isChatFollowersOnly - Restricts chat participation to followers
 * of the streamer only. Defaults to `false`.
 * @property userId              - Foreign key referencing the owning User.
 * Unique, enforcing the one-to-one constraint.
 * @property user                - Relation field resolving to the owning User
 * record. Cascades deletion when the user is
 * removed.
 * @property createdAt           - Timestamp of when the stream record was
 * created (auto-set).
 * @property updatedAt           - Timestamp of the last update to this record
 * (auto-updated).
 * @index  userId                - Optimises queries that look up the stream
 * belonging to a given user.
 * @index  ingressId             - Optimises look-ups by ingress identifier,
 * used when routing inbound media events.
 * @index  name                  - Optimises full-text search queries against
 * the stream name.
 */
model Stream {
  id                  String   @id @default(uuid())
  name                String   @db.Text
  thumbnailUrl        String?  @db.Text
  ingressId           String?  @unique
  serverUrl           String?  @db.Text
  streamKey           String?  @db.Text
  isLive              Boolean  @default(false)
  isChatEnabled       Boolean  @default(true)
  isChatDelayed       Boolean  @default(false)
  isChatFollowersOnly Boolean  @default(false)
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
  @@index([ingressId])
  @@index([name])
}

/**
 * Block model — represents a directed block relationship between two users.
 * Acts as an explicit many-to-many join table between User records.
 * A single Block record encodes that `blocker` (identified by `blockerId`)
 * has chosen to block `blocked` (identified by `blockedId`).
 * Relation naming convention used with the User model:
 * - "Blocking"  — the blocker's perspective (the user doing the blocking).
 * - "BlockedBy" — the blockee's perspective (the user being blocked).
 * Cascade deletion ensures that block records are automatically removed
 * when either the blocker or the blocked user is deleted, preventing
 * orphaned rows in the database.
 * @property id        - Unique identifier for the block relationship (UUID),
 * auto-generated.
 * @property blockerId - Foreign key referencing the User who is blocking.
 * @property blockedId - Foreign key referencing the User being blocked.
 * @property blocker   - Relation field resolving to the blocker User record.
 * Linked via the "Blocking" relation on User.
 * Cascades deletion when the blocker user is removed.
 * @property blocked   - Relation field resolving to the blocked User record.
 * Linked via the "BlockedBy" relation on User.
 * Cascades deletion when the blocked user is removed.
 * @unique [blockerId, blockedId] - Prevents duplicate block relationships;
 * a user can only block another user once.
 * @index  blockerId              - Optimises queries that look up all users
 * a given user has blocked.
 * @index  blockedId              - Optimises queries that look up all users
 * who have blocked a given user.
 */
model Block {
  id        String @id @default(uuid())
  blockerId String
  blockedId String
  blocker   User   @relation(name: "Blocking", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User   @relation(name: "BlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}
